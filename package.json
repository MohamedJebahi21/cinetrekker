    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.16.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/use-sync-external-store": "^1.5.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "eslint": "^10.8.0",
