{
  "name": "cinetrekker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run workspace:doctor",
    "prebuild": "npm run workspace:doctor",
    "prepreview": "npm run workspace:doctor",
    "preaudit:desktop": "npm run workspace:doctor",
    "pretest:e2e:desktop": "npm run workspace:doctor",
    "workspace:doctor": "node ./scripts/ensure-workspace-integrity.mjs",
    "i18n:audit": "node ./scripts/check-i18n-keys.mjs",
    "i18n:audit:strict": "node ./scripts/check-i18n-keys.mjs --strict",
    "i18n:fill": "node ./scripts/fill-i18n-missing-keys.mjs",
    "i18n:fill:check": "node ./scripts/fill-i18n-missing-keys.mjs --check",
    "i18n:verify": "npm run i18n:audit:strict && npm run i18n:fill:check",
    "i18n:report": "node ./scripts/i18n-coverage-report.mjs ./i18n-coverage-report.md",
    "dev": "vite",
    "build": "vite build",
    "test:bundle-budget": "node ./scripts/verify-bundle-budget.mjs",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:security": "node --test tests/security-api.test.mjs",
    "test:smoke": "playwright test tests/smoke.spec.ts --project=chromium",
    "audit:desktop": "node ./scripts/run-lighthouse-desktop.mjs",
    "audit:desktop:full": "npm run build && npm run audit:desktop",
    "test:e2e:desktop": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:mobile": "playwright test tests/mobile-features.spec.ts --project=mobile-safari",
    "test:e2e:mobile:search-regressions": "playwright test tests/mobile-features.spec.ts --project=mobile-safari --grep \"slash shortcuts do not open a second search dialog\""
  },
