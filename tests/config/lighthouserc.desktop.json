{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "url": ["http://localhost:4173/"],
      "settings": {
        "preset": "desktop",
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ],
        "chromeFlags": "--headless=new --no-sandbox --disable-gpu"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-desktop-report"
    }
  }
}
