# Supabase Edge Functions Environment Variables
# Copy this file to .env for local development
# DO NOT commit .env to version control

# TMDB API Key (v3 API Key or v4 Bearer Token)
# Get yours from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Browser Push delivery — server-only values. Generate a VAPID key pair once,
# set these values as Supabase Edge Function secrets, and expose only the public
# key to the Vite client as VITE_WEB_PUSH_PUBLIC_KEY.
WEB_PUSH_PUBLIC_KEY=your_vapid_public_key
WEB_PUSH_PRIVATE_KEY=your_vapid_private_key
WEB_PUSH_CONTACT_EMAIL=notifications@example.com
