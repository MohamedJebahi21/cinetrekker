# ============================================================
# CineTrekker — Environment Variables Reference
# ============================================================
# Copy this file to .env.local for local development.
# NEVER commit a file containing real secrets to version control.
#
# For Vercel production, set all server-side variables in:
#   Vercel Dashboard → Project → Settings → Environment Variables
# ============================================================

# ============================================================
# CLIENT-SIDE (VITE_ prefix — bundled into the browser bundle)
# These are PUBLIC. Do NOT put secrets here.
# ============================================================

# Supabase project URL and anon (public) key
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# TMDB API key (exposed to browser; only needed if you call TMDB directly from client)
# In production the tmdb-proxy serverless function handles all TMDB calls server-side.
VITE_TMDB_API_KEY=

# Mapbox token — required for the Filming Locations map feature
# Get yours at: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_ACCESS_TOKEN=pk.ey...

# Feature flags
VITE_ENABLE_VERCEL_ANALYTICS=false
VITE_ENABLE_VERCEL_SPEED_INSIGHTS=false

# Debug flags (safe to leave false in production)
VITE_I18N_DEBUG=false
VITE_ENV_DEBUG=false
VITE_CHUNK_ERROR_DEBUG=false

# Bot-protection site keys (public halves — safe to expose)
# Cloudflare Turnstile: https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=
# Google reCAPTCHA v3: https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=

# ============================================================
# SERVER-SIDE (private — used only in Vercel Serverless Functions)
# Set these in: Vercel Dashboard → Settings → Environment Variables
# For local dev, add to .env.local (which is gitignored by Vite)
# ============================================================

# Supabase — server-side copies (can duplicate VITE_ values for serverless)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service role key — grants full DB access. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# TMDB API key used by serverless functions (tmdb-proxy, recommend, check-followed-updates)
# Accepts both V3 hex keys and V4 JWT read-access tokens.
TMDB_API_KEY=

# OpenAI API key — used by api/recommend.js for AI recommendations
OPENAI_API_KEY=sk-...

# Resend — email delivery for the feedback form
# https://resend.com/api-keys
RESEND_API_KEY=re_...
FEEDBACK_TO_EMAIL=you@yourdomain.com
# Optional: sender address. Defaults to onboarding@resend.dev if omitted.
FEEDBACK_FROM_EMAIL=CineTrekker Feedback <noreply@yourdomain.com>

# Upstash Redis — enables distributed rate limiting across serverless instances
# Without this, rate limiting falls back to in-memory (single-instance only).
# https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# Cron job protection — a secret token that Vercel sends in X-Cron-Secret header
# Generate a strong random value: openssl rand -hex 32
CRON_SECRET=

# Bot-protection secret keys (server-side halves — keep private)
TURNSTILE_SECRET_KEY=
RECAPTCHA_SECRET_KEY=

# Security alert webhook — optional Slack/Discord/PagerDuty incoming webhook URL
# Used by securityMonitor.js to send high-severity alerts.
SECURITY_ALERT_WEBHOOK_URL=

# ============================================================
# SET AUTOMATICALLY BY VERCEL (do not set these manually)
# ============================================================
# VERCEL_ENV=production
# VERCEL_URL=cinetrekker.vercel.app
# NODE_ENV=production

# ============================================================
# HOW TO GET YOUR API KEYS
# ============================================================
# 1. SUPABASE
#    Dashboard → Project → Settings → API
#    - "Project URL"        → VITE_SUPABASE_URL / SUPABASE_URL
#    - "anon public" key    → VITE_SUPABASE_ANON_KEY / SUPABASE_ANON_KEY
#    - "service_role" key   → SUPABASE_SERVICE_ROLE_KEY  (keep secret!)
#
# 2. TMDB
#    https://www.themoviedb.org/settings/api
#    - V3 API Key (hex)     → TMDB_API_KEY  (recommended for simplicity)
#    - V4 Read Access Token → TMDB_API_KEY  (also supported)
#
# 3. OPENAI
#    https://platform.openai.com/api-keys
#    - New secret key (sk-...) → OPENAI_API_KEY
#
# 4. RESEND
#    https://resend.com/api-keys
#    - "Full access" key    → RESEND_API_KEY
#
# 5. MAPBOX
#    https://account.mapbox.com/access-tokens/
#    - Public token (pk.ey...) → VITE_MAPBOX_ACCESS_TOKEN
#
# 6. UPSTASH REDIS
#    https://console.upstash.com/ → Create database → REST API
#    - REST URL   → UPSTASH_REDIS_REST_URL
#    - REST Token → UPSTASH_REDIS_REST_TOKEN
#
# ============================================================
# SECURITY CHECKLIST
# ============================================================
# ✅ VITE_ prefix for public client variables only
# ✅ Set secrets in Vercel Dashboard for production
# ✅ Use .env.local for local dev (gitignored)
# ✅ Rotate SUPABASE_SERVICE_ROLE_KEY immediately if ever exposed
# ❌ NEVER commit .env files with real values
# ❌ NEVER use SERVICE_ROLE_KEY in client-side code
# ❌ NEVER share API keys in public repositories
