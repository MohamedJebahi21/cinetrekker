# CineTrekker Environment Variables Template
# Copy this file to .env.local for local development
# NEVER commit actual API keys to version control

# ============================================
# CLIENT-SIDE VARIABLES (Exposed to Browser)
# ============================================
# These are prefixed with VITE_ and will be bundled into the client application
# They are PUBLIC and visible in the browser - do not put secrets here

# Supabase Configuration (Public Keys)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID
# Legacy alias (optional): VITE_SUPABASE_PUBLISHABLE_KEY=...

# ============================================
# SERVER-SIDE VARIABLES (Private - Never Exposed)
# ============================================
# These are used in Vercel Serverless Functions and Edge Functions
# Set these in: Vercel Dashboard → Settings → Environment Variables
# For local dev, add to .env.local (which is gitignored)

# OpenAI API Key (for AI recommendations)
OPENAI_API_KEY=sk-...

# TMDB API Key (for movie/TV data)
TMDB_API_KEY=...

# Supabase Configuration (Server-side)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# SUPABASE EDGE FUNCTION SECRETS
# ============================================
# Set via Supabase CLI or Dashboard
# Run: supabase secrets set KEY=value

# TMDB_API_KEY=...
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... (for admin operations)

# ============================================
# OPTIONAL VARIABLES
# ============================================

# Node Environment (development, production, test)
NODE_ENV=development

# Optional telemetry/debug flags (defaults are safe for local development)
VITE_ENABLE_VERCEL_ANALYTICS=false
VITE_ENABLE_VERCEL_SPEED_INSIGHTS=false
VITE_I18N_DEBUG=false
VITE_ENV_DEBUG=false
VITE_CHUNK_ERROR_DEBUG=false
VITE_TURNSTILE_SITE_KEY=
VITE_RECAPTCHA_SITE_KEY=

# Feedback bot protection and security monitoring
TURNSTILE_SECRET_KEY=
RECAPTCHA_SECRET_KEY=
SECURITY_ALERT_WEBHOOK_URL=

# Cron protection for scheduled serverless jobs
CRON_SECRET=

# Vercel Deployment Environment (set automatically by Vercel)
# VERCEL_ENV=production
# VERCEL_URL=cinetrekker.vercel.app

# ============================================
# HOW TO GET YOUR API KEYS
# ============================================

# 1. SUPABASE:
#    - Go to: https://app.supabase.com/project/YOUR_PROJECT/settings/api
#    - Copy "Project URL" → VITE_SUPABASE_URL and SUPABASE_URL
#    - Copy "anon public" key → VITE_SUPABASE_ANON_KEY and SUPABASE_ANON_KEY
#    - Copy "service_role" key → SUPABASE_SERVICE_ROLE_KEY (keep secret!)

# 2. TMDB:
#    - Go to: https://www.themoviedb.org/settings/api
#    - Create an API key (it's free)
#    - Copy "API Key (v3 auth)" → TMDB_API_KEY

# 3. OPENAI:
#    - Go to: https://platform.openai.com/api-keys
#    - Create new secret key
#    - Copy key → OPENAI_API_KEY (starts with sk-)

# ============================================
# SECURITY NOTES
# ============================================
# ✅ DO: Use VITE_ prefix for public client variables
# ✅ DO: Set secrets in Vercel Dashboard for production
# ✅ DO: Use .env.local for local development (gitignored)
# ❌ DON'T: Commit .env files with real values
# ❌ DON'T: Use SERVICE_ROLE_KEY in client-side code
# ❌ DON'T: Share API keys in public repositories
